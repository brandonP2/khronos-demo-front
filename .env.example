# Copy to .env.local and adjust. Neither value is needed for the default local setup.

# Development only: where the Vite dev server proxies /api calls.
# Default: http://localhost:8080
KHRONOS_API_URL=http://localhost:8080

# Build time only: base URL of the API when the built app is served from another origin.
# Leave empty to call /api on the same origin. A cross-origin API needs CORS enabled,
# including `Access-Control-Expose-Headers: Retry-After, Content-Disposition` so the login
# screen can show how long to wait after too many attempts, and CSV exports keep the file
# name the API gives them.
VITE_API_URL=
